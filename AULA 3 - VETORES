#include <stdio.h>
#include <stdlib.h>

/* Faça um programa que leia 5 numeros, mostre
o maior entre os 5 primeiros e o menor entre os 
restantes. AULA 3 - 08/10/2026*/

int compara(int a, int b){
	if(a > b) return a;
	else return b;
}


int main(){
	
	int valores[10];
	int maior, menor, i;
	
	printf("Insira os valores: \n");
	
	// for(inicialização; verificação; incremento)
	
	for(i = 0; i < 10; i++){ // 10 repetições
		scanf("%d", &valores[i]);
	}
	
	for(i = 1, maior = valores[0]; i<5; i+=2){
		int temp = compara(valores[i], valores[i+1]);
		maior = compara(maior, temp);
	}
	
	
	
	printf("\n maior %d", maior);
	
	return 0;
}

