    scanf("%d", &codigo);


    switch (codigo) {

        case 1:

            if (primeiro > segundo)
                printf("Verdadeiro\n");
            else
                printf("Falso\n");

            break;


        case 2:

            if (primeiro < segundo)
                printf("Verdadeiro\n");
            else
                printf("Falso\n");

            break;


        case 3:

            if (primeiro == segundo)
                printf("Verdadeiro\n");
            else
                printf("Falso\n");

            break;


        case 4:

            if (primeiro != segundo)
                printf("Verdadeiro\n");
            else
                printf("Falso\n");

            break;


        default:

            printf("Operador invalido!\n");
    }
}



