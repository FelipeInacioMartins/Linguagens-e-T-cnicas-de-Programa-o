// TORRES DE HANOI

int A = 6;
int B = 0;
int C = 0;


void mostrarPinos() {

    printf("A = %d | B = %d | C = %d\n", A, B, C);
}


void mover(int disco, char origem, char destino) {

    printf("\nMovendo disco %d: %c -> %c\n",
           disco, origem, destino);


    if (origem == 'A') {
        A = A - disco;
    }
    else if (origem == 'B') {
        B = B - disco;
    }
    else if (origem == 'C') {
        C = C - disco;
    }


    if (destino == 'A') {
        A = A + disco;
    }
    else if (destino == 'B') {
        B = B + disco;
    }
    else if (destino == 'C') {
        C = C + disco;
    }


    mostrarPinos();
}


void hanoi(int quantidade, char origem, char destino, char auxiliar) {

    if (quantidade == 1) {

        mover(1, origem, destino);

    }
    else {

        hanoi(quantidade - 1, origem, auxiliar, destino);

        mover(quantidade, origem, destino);

        hanoi(quantidade - 1, auxiliar, destino, origem);
    }
}


