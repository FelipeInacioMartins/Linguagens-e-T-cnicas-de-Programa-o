// CONVERSÃO DE UNIDADES


int unidadeValida(int codigo) {

    if (codigo == 1 ||
        codigo == 2 ||
        codigo == 3 ||
        codigo == 4 ||
        codigo == 5 ||
        codigo == 8 ||
        codigo == 9 ||
        codigo == 10 ||
        codigo == 11) {

        return 1;
    }

    return 0;
}


float converter(float valor, int entrada, int destino) {


    // Celsius -> Fahrenheit
    if (entrada == 1 && destino == 2) {
        return valor * 1.8 + 32;
    }


    // Fahrenheit -> Celsius
    else if (entrada == 2 && destino == 1) {
        return (valor - 32) / 1.8;
    }


    // Celsius -> Kelvin
    else if (entrada == 1 && destino == 3) {
        return valor + 273.15;
    }


    // Kelvin -> Celsius
    else if (entrada == 3 && destino == 1) {
        return valor - 273.15;
    }


    // Metro -> Milha
    else if (entrada == 4 && destino == 5) {
        return valor / 1609.34;
    }


    // Milha -> Metro
    else if (entrada == 5 && destino == 4) {
        return valor * 1609.34;
    }


    // Quilograma -> Libra
    else if (entrada == 8 && destino == 9) {
        return valor * 2.205;
    }


    // Libra -> Quilograma
    else if (entrada == 9 && destino == 8) {
        return valor / 2.205;
    }


    // km/h -> mph
    else if (entrada == 10 && destino == 11) {
        return valor / 1.609;
    }


    // mph -> km/h
    else if (entrada == 11 && destino == 10) {
        return valor * 1.609;
    }


    return 0;
}


