#include <stdio.h>
#include <time.h>
// Programa que mostra a data atual e horário atual 
void showData(); // Protótipo da função

int main(){

	showData(); // Chamando a função
	return 0;
}
void showData(){

	time_t t = time(NULL);
	struct tm tm = *localtime(&t);
	int ano = tm.tm_year + 1900;
	printf("Hoje eh %02d/%02d/%04d as %2d:%02d:%02d\n", tm.tm_mday, tm.tm_mon, ano, 
			tm.tm_hour, tm.tm_min, tm.tm_sec);
	
	
}
