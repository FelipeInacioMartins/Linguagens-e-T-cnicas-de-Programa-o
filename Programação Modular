#include <stdio.h>

/* Estudos
Entrar com 3 valores / saida - 3 valores multiplicados e divido por 100
short - 2 bytes  - 16 bits
int  - 4 bytes   - 32 bits
long - 8 bytes   - 64 bits */


// Protótipos das funções que serão utilizadas
void executar();
void entradaDeValor();
float calcular();
void saidaDeValor(float resultado);

int val1, val2;
float val3;

// Função principal chamando a função executar
int main (){	
	executar();	
	return 0;
}

//Função executar chamando as funções entradaDeValor e saidaDeValor
void executar(){	
	entradaDeValor();
	saidaDeValor(calcular());
}

//Função da entradaDeValor. Apenas recebe os valores do usuário 
void entradaDeValor(){	
	puts("Entre com os valores: ");
	scanf("%d %d %f", &val1, &val2, &val3);	
}

//Função que calcula os valores
float calcular(){
	return val1 * val2 * val3 / 100;
}

//Função que mostra o resultado para o usuário
void saidaDeValor(float resultado){
	
	printf("O resultado eh: %.2f\n", resultado);	
}
