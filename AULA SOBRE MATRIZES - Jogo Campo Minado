#include <stdio.h>
#include <stdlib.h>
#include <time.h> 

#define bomba 0
#define bandeira 9

/* 
	AULA 4/11/2026 - Matrizes / Jogo - Campo minado
*/

int main(int argc, char *argv[]) {
	
	srand(time(NULL));
	int campo[9][9];
	int casaX, casaY, i, j;
	
	// Limpa a nossa matriz e insere 9 em todas as posições
	for (i = 0; i < 9; i++){
		for(j = 0; j < 9; j++){
			campo[i][j] = 9;
		}
	}
	//preenche bombas no nosso jogo
	for(i=0;i<9;i++){
		for(j=0;j<9;j++){
			if (rand()%10 == 0)
			campo[i][j] = 0;
		}
	}
	
	printf("Campo Minado \n -------------------------------\n");
	for(i=0;i<9;i++){
		printf("\t \t \t");
		for(j=0;j<9;j++){
			if (campo[i][j] == 0)printf("|9");
			else printf("|%d", campo[i][j]);
		}
		printf("\n");
	}
	
	
	return 0;
}
