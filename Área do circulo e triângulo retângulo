#include <stdio.h>
#include <stdlib.h>
#include <math.h>

	int main(int argc, char *argv[]) {
		
	// Area do circulo
	
	float raio, pi, area_circulo;
	
	printf("Insira o valor do raio: ");
	scanf("%f", &raio);
	
	pi = 3.14159;
	area_circulo = pi*pow(raio, 2);
	
	printf("O valor da area do circulo eh: %f", area_circulo);
	
	// Area do triangulo retangulo
	
	float base, altura, area_triangulo;
	
	printf("\nInsira o valor da base: ");
	scanf("%f", &base);
	
	printf("\nInsira o valor da altura: ");
	scanf("%f", &altura);
	
	area_triangulo = (base * altura)/2;
	
	printf("\nO valor da area do triangulo retangulo eh: %f", area_triangulo);

	return 0;
}
